---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// 3호기 대문 이미지 불러오기
import universeImg from '~/assets/images/universe.jpg';

const metadata = {
  title: 'Daily Work Hack — AI & Workflow Automation',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Automation',
        href: '/category/automation',
        icon: 'tabler:chevron-right',
      },
    ]}
    image={{
      src: universeImg,
      alt: 'Automation - AI & Workflow Solutions',
    }}
  >
    <Fragment slot="title">
      Automation & Productivity,<br />
      <span class="text-accent dark:text-white highlight">AI & Workflow Solutions</span>
    </Fragment>

    <Fragment slot="subtitle">
      Eliminate repetitive manual tasks. Master modern AI tools, Excel Power Query, and smart office automation workflows.
    </Fragment>
  </Hero>

  <!-- Latest Posts Section -->
  <BlogLatestPosts
    title="Latest Articles"
    information="Explore actionable AI prompts, spreadsheet formulas, and verified automation workflows."
    count={6}
  />
</Layout>
